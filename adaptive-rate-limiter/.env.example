# ==============================================================================
# Adaptive Rate Limiter - Environment Configuration
# Copy this file to .env on Laptop 1 (Server) and Laptop 2 (Customer)
# ==============================================================================

# --- Laptop 1: FastAPI Server Settings ---
APP_NAME="Adaptive Rate Limiter API"
APP_ENV="development"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
LOG_LEVEL="INFO"

# --- Laptop 1: Redis Settings (Bind Redis to localhost only; never expose publicly) ---
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_SOCKET_TIMEOUT=2.0

# --- Security & Admin Authentication ---
# Change this token before demonstrating or running on a shared network
ADMIN_API_TOKEN="change-me-admin-secret-token"
ALLOWED_CORS_ORIGINS="*"

# --- Rate Limiting Defaults (Used in Stage 2+) ---
DEFAULT_ALGORITHM="adaptive"
FIXED_WINDOW_LIMIT=60
FIXED_WINDOW_SECONDS=60
TOKEN_BUCKET_CAPACITY=60
TOKEN_BUCKET_REFILL_RATE=1.0
SLIDING_WINDOW_LIMIT=60
SLIDING_WINDOW_SECONDS=60

# --- Adaptive Controller Parameters (Used in Stage 4+) ---
ADAPTIVE_BASE_LIMIT=60
ADAPTIVE_MIN_LIMIT=10
ADAPTIVE_MAX_LIMIT=200
ADAPTIVE_ALPHA=0.50
ADAPTIVE_BETA=0.60
ADAPTIVE_GAMMA=0.50

# --- Laptop 2: Customer App Settings (Used in Stage 7+) ---
# Replace 127.0.0.1 with Laptop 1's Wi-Fi IPv4 address (e.g., http://192.168.1.10:8000)
SERVER_BASE_URL="http://127.0.0.1:8000"
